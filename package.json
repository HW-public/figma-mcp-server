{
  "name": "figma-mcp-server",
  "version": "1.0.1",
  "description": "Unified Figma MCP server: REST headless read + live plugin-bridge read/write",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_execpath || !process.env.npm_execpath.includes('pnpm')) { console.error('Please use pnpm to install dependencies.'); process.exit(1); }\"",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "bundle": "node scripts/bundle.mjs",
    "release": "pnpm run build && pnpm run bundle",
    "smoke": "node test/smoke.mjs",
    "plugin:build": "node plugin/build.mjs",
    "plugin:typecheck": "tsc -p plugin/tsconfig.json --noEmit",
    "customizations": "node scripts/list-customizations.mjs",
    "release:check": "node scripts/release-check.mjs",
    "sync:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-sync.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.14.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jimp": "^0.22.12",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.2",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zod": "^4.6.6"
  }
}
