# Figma REST API token (https://www.figma.com/developers/api#access-tokens)
# 只读 token 即可满足 REST 通道
FIGMA_API_KEY=

# Figma REST API base url（自建代理时可改）
FIGMA_BASE_URL=https://api.figma.com/v1

# figma-edit-mcp socket 桥端口（默认 3055）
FIGMA_EDIT_BRIDGE_PORT=3055

# 可选：固定频道码，启动时自动 channel_join（首次人工 join 成功后会自动写入）
FIGMA_MCP_CHANNEL=

# 资源默认输出目录
FIGMA_ASSETS_DIR=./figma-assets
